<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Glow / Ring -->
    <path
        android:pathData="M54,54m-33,0a33,33 0,1,1 66,0a33,33 0,1,1 -66,0"
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8" />

    <!-- Golden Coin Base -->
    <path
        android:pathData="M54,54m-28,0a28,28 0,1,1 56,0a28,28 0,1,1 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="28"
                android:endX="76"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FDE047" />
                <item android:offset="0.45" android:color="#EAB308" />
                <item android:offset="1.0" android:color="#CA8A04" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Coin Rim -->
    <path
        android:pathData="M54,54m-23,0a23,23 0,1,1 46,0a23,23 0,1,1 -46,0"
        android:strokeWidth="1.8"
        android:strokeColor="#FEF08A" />

    <!-- Emerald Center Crest -->
    <path
        android:pathData="M54,54m-17,0a17,17 0,1,1 34,0a17,17 0,1,1 -34,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="38"
                android:endX="68"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981" />
                <item android:offset="1.0" android:color="#047857" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Checkmark / Task Earn Mark in Crisp White -->
    <path
        android:fillColor="#00000000"
        android:pathData="M44,54.5 L51,61.5 L64,47"
        android:strokeWidth="4.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Star accent top-right -->
    <path
        android:pathData="M73,35 L75,40 L80,41 L76,44 L77,49 L73,46 L69,49 L70,44 L66,41 L71,40 Z"
        android:fillColor="#FBBF24" />
</vector>
